{
  "name": "hush",
  "private": true,
  "version": "5.1.13",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev:api": "node --experimental-strip-types scripts/dev-api.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:ipa": "npm run ios:sync && bash scripts/build-ios.sh"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "@vercel/connect": "^0.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
